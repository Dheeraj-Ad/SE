HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/lobby.sqlite
CAMPUS_TIMEZONE=Asia/Kolkata
SESSION_HOURS=8
SECURE_COOKIES=false
# Default local mail delivery uses an on-disk outbox visible to Admin.
# To deliver externally, set MAIL_MODE=smtp and configure all SMTP settings.
MAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=lobby@campus.example
